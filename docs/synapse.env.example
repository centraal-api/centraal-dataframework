# Variables para el notebook docs/03_synapse.ipynb y pytest -m synapse.
# Copiar a la raíz del repo como `.env.synapse` (ignorado por git) y completar.
# Sin secretos: por defecto se autentica con `az login` / Managed Identity (DefaultAzureCredential).

# --- Conexión (obligatorio uno de los dos) ---
# Nombre del workspace: usa <workspace>-ondemand.sql.azuresynapse.net (serverless)
SYNAPSE_WORKSPACE=
# Servidor explícito (p.ej. pool dedicado <workspace>.sql.azuresynapse.net). Tiene prioridad.
# SYNAPSE_SERVER=

# Base por defecto (p.ej. master, o una base de lectura del ambiente)
SYNAPSE_DATABASE=master

# identity (recomendado) | sql (solo desarrollo local)
SYNAPSE_AUTH=identity
# SYNAPSE_USER=
# SYNAPSE_PASSWORD=

# Segundos por consulta (límite de serverless: 30 min)
SYNAPSE_QUERY_TIMEOUT=1800

# Driver ODBC instalado (ver `pyodbc.drivers()`); en la Function, el que traiga la imagen
SYNAPSE_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# --- Datos de prueba del ambiente (opcionales; los pasos se saltan si están vacíos) ---
# Tabla o vista a leer, como esquema.tabla (o base.esquema.tabla)
SYNAPSE_TEST_TABLE=
# Otra base para probar for_database / synapse_for (p.ej. silver)
SYNAPSE_TEST_OTHER_DB=
# Esquema donde la identidad puede crear y borrar una vista temporal (prueba de DDL con execute_file).
# Dejar vacío para una prueba de solo lectura.
SYNAPSE_TEST_DDL_SCHEMA=
# GX nativo contra Synapse (plan A): un SELECT con solo las columnas a validar y el filtro de partición,
# p.ej. SELECT id, name FROM atera.odoo_res_partner WHERE fecha = '2026-09-24'
SYNAPSE_TEST_GX_QUERY=
# Una columna de esa consulta
SYNAPSE_TEST_GX_COLUMN=
