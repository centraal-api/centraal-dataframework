# Variables para los notebooks docs/01_datalake.ipynb y docs/02_great_expectations.ipynb.
# Copiar a la raíz del repo como `.env` (ignorado por git) y completar.

# --- Conexión al lago (una de las dos) ---
# Con AccountKey: autenticación por clave (necesaria para links SAS y read_csv_with_partition).
# Déjela comentada si usa identidad: vacía (AZURE_STORAGE_CONNECTION_STRING=) rompe la autenticación por identidad,
# porque adlfs la toma como una conexión real.
# AZURE_STORAGE_CONNECTION_STRING=
# Solo el nombre de la cuenta: identidad (az login / Managed Identity)
# STORAGE_ACCOUNT_NAME=

# --- Datos de prueba ---
# contenedor/carpeta donde la identidad puede escribir; el notebook crea y borra una subcarpeta
DATALAKE_TEST_PATH=

# --- Conexión con nombre (opcional, sección 4 de 01_datalake) ---
# AZURE_STORAGE_CONNECTION_STRING__CURADO=
# STORAGE_ACCOUNT_NAME__CURADO=

# --- Great Expectations (opcional) ---
# Contenedor de los reportes cuando hay storage (default: calidad-datos)
# CONTENEDOR_VALIDACIONES=calidad-datos
